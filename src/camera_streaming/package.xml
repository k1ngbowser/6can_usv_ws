<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camera_streaming</name>
  <version>1.0.0</version>
  <description>Publishes surface and underwater USB camera feeds as ROS 2 image topics (via OpenCV) and republishes them over HTTP as MJPEG on port 8000.</description>
  <maintainer email="miguel_gonzalezr@ieee.org">Miguel Angel Gonzalez Rodriguez</maintainer>
  <license>BSD 3-Clause</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- opencv-python-headless and numpy are installed via pip in the
       Dockerfile, not apt/rosdep, to avoid pulling the desktop
       opencv-contrib (Qt/VTK/GDAL) dependency chain. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
